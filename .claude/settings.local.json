{
  "permissions": {
    "allow": [
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(echo *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(MSYS_NO_PATHCONV=1 *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(psql *)",
      "Bash(py *)",
      "Bash(python *)",
      "Bash(scp *)",
      "Bash(sed *)",
      "Bash(ssh *)",
      "Bash(timeout *)",
      "Read(//tmp/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && command -v powershell.exe >/dev/null 2>&1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/session-boot.ps1 -ProjectRoot \"$CLAUDE_PROJECT_DIR\" || true"
          }
        ]
      }
    ]
  }
}
