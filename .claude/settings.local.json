{
  "permissions": {
    "allow": [
      "Bash(grep -v \".tsx\\\\|.ts$\")",
      "Bash(npm install *)",
      "Bash(pnpm install *)",
      "Bash(git -C \"D:/heuresys-advanced\" status --short)",
      "Bash(git -C \"D:/heuresys-advanced\" log --oneline -10)",
      "Bash(git -C \"D:/heuresys-advanced\" tag --sort=-creatordate)",
      "Bash(git -C \"D:/heuresys-advanced\" status -b --short)",
      "Bash(psql -h localhost -p 5433 -U heuresys -d heuresys_advanced -c \"SELECT COUNT\\(*\\) AS login_events FROM sys.sys_auth_login_events;\")",
      "Bash(rm -rf test-results/*)",
      "Bash(pnpm exec *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(MSYS_NO_PATHCONV=1 ssh oracle-vm-default:*)",
      "Read(//tmp/**)",
      "Bash(pnpm typecheck:test)",
      "Bash(psql *)"
    ]
  },
  "skillOverrides": {
    "consolida-pagina": "off",
    "dashboards-jobs": "off",
    "multi-tenant-validator": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && sh scripts/hooks/hook.sh prompt-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && sh scripts/hooks/hook.sh lab-guard",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && sh scripts/hooks/hook.sh stop-gate",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && sh scripts/hooks/hook.sh stop-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
