# =============================================================================
# Heuresys Advanced — .env.example
# Copy to .env and fill in secrets. Never commit .env (gitignored).
# Three runtime blocks per ADR-0010: A localhost / B OCI VM / C OCI Managed.
# Current decision (RD-25, 2026-05-16): Option B — OCI VM oracle-vm-default.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# PostgreSQL — Option B (ACTIVE) — OCI VM oracle-vm-default via SSH tunnel
# Tunnel: ssh -L 5433:localhost:5432 oracle-vm-default
# Keep this block uncommented as the working configuration per RD-25.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=heuresys_advanced
POSTGRES_USER=heuresys
POSTGRES_PASSWORD=change_me_dev_secret
POSTGRES_SCHEMA=sys
POSTGRES_SSL=disable

# Superuser (only used by db/scripts/create_local_database.* and reset_local_database.*)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_secret

# -----------------------------------------------------------------------------
# PostgreSQL — Option A (FALLBACK) — localhost native PostgreSQL on Windows PC
# Uncomment THIS block and comment out Option B if reverting to localhost.
# -----------------------------------------------------------------------------
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=heuresys_advanced
# POSTGRES_USER=heuresys
# POSTGRES_PASSWORD=change_me_dev_secret
# POSTGRES_SCHEMA=sys
# POSTGRES_SSL=disable
# POSTGRES_SUPERUSER=postgres
# POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_secret

# -----------------------------------------------------------------------------
# PostgreSQL — Option C (FUTURE) — OCI Managed PostgreSQL (EU Milan)
# Uncomment THIS block when ADR-0010 is reopened for production cutover.
# Cost not verified as of 2026-05; SSL is mandatory.
# -----------------------------------------------------------------------------
# POSTGRES_HOST=<endpoint>.adb.eu-milan-1.oraclecloud.com
# POSTGRES_PORT=5432
# POSTGRES_DB=heuresys_advanced
# POSTGRES_USER=heuresys
# POSTGRES_PASSWORD=change_me_managed_secret
# POSTGRES_SCHEMA=sys
# POSTGRES_SSL=require

# -----------------------------------------------------------------------------
# Auth — JWT (RS256), Cookies, CSRF (per AUTH_SECURITY_PLAN §4)
# Generate JWT keys via: openssl genrsa -out jwt_private.pem 2048
#                        openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then paste PEM content as single-line value (use \n for newlines) or load via fs.
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
COOKIE_SECRET=change_me_at_least_32_chars_long_aaaaaa
ADMIN_ORIGIN=http://localhost:3000

# MFA — TOTP (REQUIRED post Tappa E MVP-3 v0.3.2-mvp3-full)
# Used to encrypt sys_auth_mfa_factors.factor_secret_encrypted at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Without this, mfa-service throws MFA_ENCRYPTION_KEY_MISSING at boot.
MFA_ENCRYPTION_KEY=change_me_32_byte_base64

# -----------------------------------------------------------------------------
# Frontend (apps/web) — Next.js public env (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# -----------------------------------------------------------------------------
# Seed reference bank — deterministic Faker seed (RD-Q6, default 42)
# -----------------------------------------------------------------------------
SEED_REFERENCE_BANK_SEED=42
