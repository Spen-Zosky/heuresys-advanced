# =============================================================================
# Heuresys Advanced — .env.example
# Copy to .env and fill in secrets. Never commit .env (gitignored).
# Three runtime blocks per ADR-0010: A localhost / B OCI VM / C OCI Managed.
# Current decision (RD-25, 2026-05-16): Option B — OCI VM oracle-vm-default.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# Reverse-proxy trust for req.ip (per-IP rate-limiting). "false"/"" = direct (no proxy);
# "true" = trust whole X-Forwarded-For chain (SPOOFABLE — avoid in prod); "<n>" = trust n
# proxy hops (PROD behind a single nginx TLS proxy = 1 → keys on the real client IP, a forged
# XFF cannot evade the login limiter); "<ip|cidr>[,…]" = explicit trust-list. NOTE: parsed
# explicitly — do NOT expect z.coerce.boolean semantics ("false" really means false here).
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# PostgreSQL — Option B (ACTIVE) — OCI VM oracle-vm-default via SSH tunnel
# Tunnel: ssh -L 5433:localhost:5432 oracle-vm-default
# Keep this block uncommented as the working configuration per RD-25.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=heuresys_advanced
POSTGRES_USER=heuresys
POSTGRES_PASSWORD=change_me_dev_secret
POSTGRES_SCHEMA=sys
POSTGRES_SSL=disable

# Superuser (only used by db/scripts/create_local_database.* and reset_local_database.*)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_secret

# -----------------------------------------------------------------------------
# PostgreSQL — Option A (FALLBACK) — localhost native PostgreSQL on Windows PC
# Uncomment THIS block and comment out Option B if reverting to localhost.
# -----------------------------------------------------------------------------
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=heuresys_advanced
# POSTGRES_USER=heuresys
# POSTGRES_PASSWORD=change_me_dev_secret
# POSTGRES_SCHEMA=sys
# POSTGRES_SSL=disable
# POSTGRES_SUPERUSER=postgres
# POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_secret

# -----------------------------------------------------------------------------
# PostgreSQL — Option C (FUTURE) — OCI Managed PostgreSQL (EU Milan)
# Uncomment THIS block when ADR-0010 is reopened for production cutover.
# Cost not verified as of 2026-05; SSL is mandatory.
# -----------------------------------------------------------------------------
# POSTGRES_HOST=<endpoint>.adb.eu-milan-1.oraclecloud.com
# POSTGRES_PORT=5432
# POSTGRES_DB=heuresys_advanced
# POSTGRES_USER=heuresys
# POSTGRES_PASSWORD=change_me_managed_secret
# POSTGRES_SCHEMA=sys
# POSTGRES_SSL=require

# -----------------------------------------------------------------------------
# Auth — JWT (RS256), Cookies, CSRF (per AUTH_SECURITY_PLAN §4)
# Generate JWT keys via: openssl genrsa -out jwt_private.pem 2048
#                        openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then paste PEM content as single-line value (use \n for newlines) or load via fs.
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
COOKIE_SECRET=change_me_at_least_32_chars_long_aaaaaa
ADMIN_ORIGIN=http://localhost:3000
# Auth cookie Secure flag (access/refresh/csrf). Unset → defaults to (NODE_ENV===production).
# Secure cookies require HTTPS: a browser DROPS them over plain HTTP, so login silently fails
# (POST /login is 200 but the session cookie isn't stored). Set COOKIE_SECURE=false when serving
# production over HTTP without TLS (e.g. the OCI VM demo http://<ip>:3013); set true behind a TLS proxy.
# COOKIE_SECURE=false

# MFA — TOTP encryption-at-rest key (QW-SEC6, AES-256-GCM). ACTIVE (D-30 RESOLVED
# 2026-06-17): consumed by apps/api/src/modules/auth/secret-crypto.ts at the
# mfa-repository boundary. KEY-PRESENCE GATE — non-breaking:
#   • UNSET → TOTP factor secrets stay base32-plaintext (legacy mode, no error).
#   • SET   → new TOTP secrets are stored AES-256-GCM (enc:v1:… prefix); legacy
#             plaintext rows still decrypt/verify and are lazily upgraded on use.
# REQUIRED in any env that stores ciphertext, and MUST be present (same value)
# in PROD BEFORE the one-time bulk-encrypt of the existing rows (db:encrypt-totp).
# It propagates to PROD via scripts/align-clones.sh (it is NOT on the
# scripts/env-key-merge.sh denylist). Accepts: 64 hex chars, base64 of 32 bytes,
# or any string ≥32 chars (scrypt-derived). Generate a strong key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=change_me_32_byte_hex_or_base64

# Mandatory-MFA login ENFORCEMENT kill-switch (S989 dev/test neutralization).
# DEFAULT true (enforced) when UNSET — PROD/VM/linuxpc MUST leave it unset or
# true so the live mandatory-MFA policy keeps protecting login. Set to false
# ONLY in a local dev/test .env to bypass the login second-factor gate so
# development + automated testing proceed without MFA (the MFA capability,
# enrolled factors and per-tenant policy DATA all stay intact; re-enable =
# config only). On the scripts/env-key-merge.sh denylist → a local 'false' is
# NEVER propagated to a remote by align-clones.sh.
# MFA_ENFORCEMENT_ENABLED=false

# -----------------------------------------------------------------------------
# AI ② Semantic Matching — Voyage embeddings (voyage-4-lite, 1024-dim)
# ONLY required to run the embedding backfill (pnpm embeddings:backfill).
# The serving API does NOT need it (kNN runs over precomputed pgvector rows).
# Create a key at https://dashboard.voyageai.com/organization/api-keys
# -----------------------------------------------------------------------------
# VOYAGE_API_KEY=pa-...

# AI ②·Fase 2 — free-text matching feature flag. Default OFF.
# When OFF, GET /v1/matching/search returns 404 MATCHING_FREETEXT_DISABLED.
# When ON, the query is embedded AT REQUEST TIME via Voyage (the first query-time
# external dependency on the serving path) → requires VOYAGE_API_KEY. Leave OFF
# in normal operation to keep the serving path Voyage-free.
# MATCHING_FREETEXT_ENABLED=false

# -----------------------------------------------------------------------------
# API docs (R6) — OpenAPI/Swagger exposure. DEFAULT OFF.
# When true: Swagger UI at /docs + OpenAPI spec at /openapi.json (the full /v1/*
# surface). Enable in dev/staging; keep OFF on a public prod origin (or gate it
# behind an authenticated edge) so the API surface isn't publicly enumerable.
# -----------------------------------------------------------------------------
# API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# Transactional mailer (SMTP) — password-reset + EMAIL_OTP + 3.4 digest delivery
# ALL OPTIONAL. When SMTP_HOST + MAIL_FROM are set, the API uses the real
# SmtpMailer (nodemailer, provider-agnostic: SES SMTP / Postmark / Mailgun /
# Gmail relay / Outlook / Postfix). When unset, it falls back to the dev
# ConsoleMailer (logs the link/code — never use in prod). SMTP_SECURE = 'true'
# for port 465 (implicit TLS), 'false' for 587 (STARTTLS).
#
# NO SMTP PROVIDER? The platform is fully operable without one (S993 workaround):
#   - MFA runs on TOTP (offline authenticator app) + WebAuthn (passkey) — no email.
#     EMAIL_OTP is auto-HIDDEN from enrollment until SMTP is configured, so nobody
#     can lock themselves out on codes that never arrive (mirrors the SMS gate).
#   - Notifications: the in-app notification center is the primary channel (live).
#     The 3.4 email digest is a dormant enhancement — it activates the moment SMTP
#     is set, no code change.
#   - Password-reset email needs a transport; until then reset via the seed script
#     (pnpm db:seed-test-admin) / DB.
# A FREE SMTP is enough to switch everything on — e.g. an Outlook/Gmail app-password
# (no paid provider, no custom domain needed). Uncomment ONE recipe below:
#
#   # Outlook / Microsoft 365 (account you already own):
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=enzo.spenuso@outlook.com
#   SMTP_PASSWORD=<app-password>            # account.microsoft.com → Security → app passwords
#   MAIL_FROM=Heuresys <enzo.spenuso@outlook.com>
#
#   # Gmail (app-password, 2FA must be on):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char app-password>    # myaccount.google.com → Security → app passwords
#   MAIL_FROM=Heuresys <you@gmail.com>
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=change_me
# MAIL_FROM=Heuresys <noreply@your-domain.com>

# -----------------------------------------------------------------------------
# MFA enrollment confirmation (TOFU v2) — "auto" (default) confirms the first
# self-owned factor (TOTP/WEBAUTHN/SMS_OTP) out-of-band only when SMTP is
# configured; "on" forces it; "off" for dev (no real mail backend).
# -----------------------------------------------------------------------------
# MFA_ENROLL_CONFIRM=auto

# -----------------------------------------------------------------------------
# WebAuthn / FIDO2 passkey MFA. WEBAUTHN_RP_ID = effective domain (NO scheme,
# NO port): "localhost" for dev, the real registrable domain in prod. ORIGINS =
# exact allowlist (scheme+host+port), comma-separated. Passkeys need a secure
# context — localhost is exempt, plain-HTTP non-localhost is NOT (needs TLS).
# -----------------------------------------------------------------------------
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Heuresys
# WEBAUTHN_ORIGINS=http://localhost:3000,https://www.heuresys.com

# -----------------------------------------------------------------------------
# SMS_OTP MFA factor — OPTIONAL, code-only slice. No real provider yet
# (makeSmsSender returns ConsoleSms → SMS_OTP enrollment stays disabled). Set
# these when a provider (e.g. twilio) lands to switch the factor on.
# -----------------------------------------------------------------------------
# SMS_PROVIDER=twilio
# SMS_FROM=+15555550100

# -----------------------------------------------------------------------------
# CMS media object store root (local-disk default, S980; S3/MinIO = future
# driver behind the same seam — see apps/api/src/modules/content/media-store.ts).
# -----------------------------------------------------------------------------
# MEDIA_STORAGE_DIR=.data/media

# -----------------------------------------------------------------------------
# Frontend (apps/web) — Next.js public env (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# -----------------------------------------------------------------------------
# Seed reference bank — deterministic Faker seed (RD-Q6, default 42)
# -----------------------------------------------------------------------------
SEED_REFERENCE_BANK_SEED=42

# -----------------------------------------------------------------------------
# Ops — scheduled DB backup (R5). All OPTIONAL; scripts/backup-db.sh defaults
# apply when unset (fired daily by heuresys-advanced-backup.timer): pg_dump -Fc →
# timestamped file in BACKUP_DIR, prune older than BACKUP_RETENTION_DAYS, optional
# best-effort off-host copy.
#   • BACKUP_DIR            default $REPO/pg_dump_snapshots/scheduled
#   • BACKUP_RETENTION_DAYS default 14 (prunes only ${DB_NAME}_*.dump inside BACKUP_DIR;
#                           never touches manual pre-op snapshots in the parent dir)
#   • BACKUP_OFFHOST_SSH    opt-in scp target user@host:/path (non-fatal on failure);
#                           unset = local-with-retention only. A real off-host bucket/twin
#                           is a later infra decision.
# -----------------------------------------------------------------------------
# BACKUP_DIR=
# BACKUP_RETENTION_DAYS=14
# BACKUP_OFFHOST_SSH=user@host:/path/to/offhost/backups

# -----------------------------------------------------------------------------
# Agent SDK service user (#9 WI-A.2) — headless catalogue author (PLATFORM_ADMIN)
# OPT-IN: db/scripts/seed-service-user.ts is a NO-OP unless BOTH EMAIL + PASSWORD
# are set. The password lives ONLY here / in the secret store — never logged (R11).
# The account gets a sys_auth_mfa_exemptions row (MFA-exempt login, mig 000116/000117),
# eligible via its PLATFORM_ADMIN grant. Run: pnpm db:seed-service-user
# -----------------------------------------------------------------------------
# AGENT_SERVICE_USER_EMAIL=agent-sdk@heuresys.com
# AGENT_SERVICE_USER_PASSWORD=change_me_strong_secret
# AGENT_SERVICE_USER_DISPLAY_NAME=Agent SDK Service
# AGENT_SERVICE_USER_TENANT_CODE=          # optional; default = tenant of admin@heuresys.com
# AGENT_SERVICE_USER_RESET_PASSWORD=1      # optional; rotate the credential on re-run

# -----------------------------------------------------------------------------
# Agent gateway (#9 apps/agent-gateway) — runtime auth for the Claude Agent SDK
# AGENT_GATEWAY_SUBSCRIPTION_AUTH=1 makes the gateway DELETE any ANTHROPIC_API_KEY
# from its env so the SDK falls back to the machine's logged-in Claude credentials
# (~/.claude/.credentials.json) = the operator's Claude MAX subscription, zero
# marginal cost. This is the CANONICAL way to run the gateway in this project: no
# Anthropic API key is required (verified live S990/S991). A real ANTHROPIC_API_KEY
# / AWS Bedrock / GCP Vertex would only be needed for a customer-facing production
# serving — a future new scope, not a blocker on the current agent.
# -----------------------------------------------------------------------------
# AGENT_GATEWAY_SUBSCRIPTION_AUTH=1
# AGENT_GATEWAY_PORT=8790
# HEURESYS_API=http://localhost:3001
# AGENT_GATEWAY_APPROVAL_TIMEOUT_MS=120000
