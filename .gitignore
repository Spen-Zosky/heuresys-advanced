# =============================================================================
# Heuresys Advanced — .gitignore
# Heuresys Advanced HRMS/BPM Platform v5 Bootstrap
# =============================================================================

# -----------------------------------------------------------------------------
# Session-align marker — per-session delta basis (written by session-boot.ps1,
# consumed by the handoff close-flow). Per-machine, never committed.
# -----------------------------------------------------------------------------
.session-align.marker

# -----------------------------------------------------------------------------
# Brownfield extraction & inspection artifacts (HARD REQUIREMENT)
# -----------------------------------------------------------------------------
# The original db-export.zip stays versioned as input material under
# docs/source_bundle/brownfield/db-export.zip. The extracted working copy and
# the inspection artifacts must NEVER be committed: they may contain (or
# replicate) sensitive legacy data that the canonical architecture deliberately
# excludes (PII, payroll, medical, attendance, raw SAP HR, etc.).
docs/source_bundle/brownfield/extracted/
docs/brownfield/_inspection_artifacts/

# Wave 1 legacy data dumps (~356 MB, regenerable via
# db/scripts/extract-wave1-legacy.sh against oracle-vm-default).
# We keep the regenerator committed; the dump payload is reproducible
# from the live legacy DB on demand.
db/seeds/brownfield/wave1/legacy_data/

# RTL tenant-rebuild legacy subset (regenerable via db/seeds/rtl-rebuild/00_extract_legacy_subset.sh).
# Commit the regenerator + load SQL; the extracted CSV payload stays out of git.
db/seeds/rtl-rebuild/extracted/

# -----------------------------------------------------------------------------
# Secrets / env files
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
!*.key.example
.secrets/

# -----------------------------------------------------------------------------
# Node / pnpm
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Test / coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
qa_artifacts/runs/
qa_artifacts/schema_snapshot_*.sql
qa_artifacts/schema_snapshot_*.sql.filtered
qa_artifacts/db_snapshots/

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/

# -----------------------------------------------------------------------------
# Python (used only for brownfield inspection scripts)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# -----------------------------------------------------------------------------
# PostgreSQL local artifacts
# -----------------------------------------------------------------------------
*.dump
*.backup
pg_dump_snapshots/

# -----------------------------------------------------------------------------
# Optional Docker (not on canonical path — see ADR-0004)
# -----------------------------------------------------------------------------
# Docker is NOT part of the canonical runtime. If a contributor adds an
# optional docker-compose.yml under docs/optional/docker/, that file is fine
# to commit, but volumes/data must not be.
docs/optional/docker/data/
docs/optional/docker/.volumes/

# -----------------------------------------------------------------------------
# Claude / Cowork transient artifacts
# -----------------------------------------------------------------------------
# Git worktrees created locally for parallel branches (e.g. brand-identity-v1
# via .claude/worktrees/musing-wing-NNN). These are checkout copies, not source
# of truth — they regenerate via `git worktree add`.
.claude/worktrees/

# Cowork protocol transient files: lock acquired during active sessions,
# pending-commits manifest auto-cleaned post-apply, inbox INDEX auto-generated
# via `pnpm cowork:inbox:rebuild`. None of these are SoT — they regenerate.
cowork_code_exchange/.cowork-active.lock
cowork_code_exchange/.cowork-pending-commits.json
cowork_code_exchange/.cowork-pending-commits/
cowork_code_exchange/.inbox/INDEX.md

# graphify knowledge-graph outputs (generated, external graph lives in wiki-space)
graphify-out/
.graphify_root
.graphify_python
docs/kb/tools/.sync.log

# -----------------------------------------------------------------------------
# Apify Actor run results archive (local-only durable copy)
# -----------------------------------------------------------------------------
# Convention in .apify/README.md: every Apify Actor run gets its results saved
# under .apify/<YYYY-MM-DD>/. Kept out of git (per-machine local copy) — the
# cloud dataset IDs + console URLs recorded in each .meta.json are the link back
# to Apify while the unnamed datasets still exist.
.apify/

# cap4 CMS P3 - local-disk media object store (default MEDIA_STORAGE_DIR)
.data/

# Claude ecosystem alignment - drift/acceptance reports (per-machine, local-only)
deploy/reports/
