*.log
logs/

# -----------------------------------------------------------------------------
# Python (used only for brownfield inspection scripts)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# -----------------------------------------------------------------------------
# PostgreSQL local artifacts
# -----------------------------------------------------------------------------
*.dump
*.backup
pg_dump_snapshots/

# -----------------------------------------------------------------------------
# Optional Docker (not on canonical path — see ADR-0004)
# -----------------------------------------------------------------------------
# Docker is NOT part of the canonical runtime. If a contributor adds an
# optional docker-compose.yml under docs/optional/docker/, that file is fine
# to commit, but volumes/data must not be.
docs/optional/docker/data/
docs/optional/docker/.volumes/

# -----------------------------------------------------------------------------
# Claude / Cowork transient artifacts
# -----------------------------------------------------------------------------
# Git worktrees created locally for parallel branches (e.g. brand-identity-v1
# via .claude/worktrees/musing-wing-NNN). These are checkout copies, not source
# of truth — they regenerate via `git worktree add`.
.claude/worktrees/

# Cowork protocol transient files: lock acquired during active sessions,
# pending-commits manifest auto-cleaned post-apply, inbox INDEX auto-generated
# via `pnpm cowork:inbox:rebuild`. None of these are SoT — they regenerate.
cowork_code_exchange/.cowork-active.lock
cowork_code_exchange/.cowork-pending-commits.json
cowork_code_exchange/.cowork-pending-commits/
cowork_code_exchange/.inbox/INDEX.md

# graphify knowledge-graph outputs (generated, external graph lives in wiki-space)
graphify-out/
.graphify_root
.graphify_python
docs/kb/tools/.sync.log

# -----------------------------------------------------------------------------
# Apify Actor run results archive (local-only durable copy)
# -----------------------------------------------------------------------------
# Convention in .apify/README.md: every Apify Actor run gets its results saved
# under .apify/<YYYY-MM-DD>/. Kept out of git (per-machine local copy) — the
# cloud dataset IDs + console URLs recorded in each .meta.json are the link back
# to Apify while the unnamed datasets still exist.
.apify/

# cap4 CMS P3 - local-disk media object store (default MEDIA_STORAGE_DIR)
.data/

# Claude ecosystem alignment - drift/acceptance reports (per-machine, local-only)
deploy/reports/

# -----------------------------------------------------------------------------
# web-qa-audit — secret-bearing files ONLY (test creds + live JWT session states)
# -----------------------------------------------------------------------------
# The audit/ working dir is owned by the web-qa-audit skill. Reports/findings
# under it stay committable at Enzo's discretion; these specific files must NEVER
# be committed (R10): roles-config holds a login password, auth-*.json holds live
# session cookies/JWT captured by Playwright storageState.
audit/roles-config.json
audit/auth-*.json
audit/manual-auth-*.json
# Heavy/transient audit working artifacts (screenshots, per-page logs, batch logs,
# inventories). The lightweight report deliverables (FINDINGS.md, FORENSIC-NOTES*.md,
# _visual-confirmed.json) stay committable.
audit/screenshots/
audit/pages/
audit/logs/
audit/inventory/
audit/*.log
audit/reverify*.json
audit/runner-summary.json
audit/execution-context.json
audit/stack-detection.json
# Machine-output trees + transient run-logs surfaced by the S1006 forensic audit
# (axe/cwv/security JSON dumps, the visual-workflow driver, per-run history/blocklog).
# Reproducible from a re-run; the curated reports above stay committed.
audit/a11y/
audit/perf/
audit/security/
audit/context-history.json
audit/_visual-workflow.js
audit/BLOCKED-LOG.md

# ESCO official dataset (v1.2.0 IT) — large, publicly re-downloadable reference input.
# Versioned: the loader script + converter + README (provenance). NOT the payload.
ESCO dataset*.zip
db/data/esco/*.tsv
db/data/esco/*.csv

# zero-pending-loop: stato di runtime. PROGRESS.md invece e versionato,
# cosi Enzo lo legge su GitHub dal telefono.
.zp/*
!.zp/PROGRESS.md

# verification gate (W10)
.zp/verify-verdict.json
.zp/verify-off

# Vettori dei concetti di dominio (ADR-0033): artefatto di MISURA, non stato.
# ~1,2 MB di float illeggibili in diff, rigenerabili con una chiamata Voyage da
# docs/kb/atlas/concepts-corpus.jsonl. Restano versionati il corpus (49 KB, si
# legge e si confronta) e il referto della misura (6 KB, e' l'evidenza del
# verdetto): quelli dicono qualcosa a chi apre il repo, i vettori no.
docs/kb/atlas/concepts-vectors.json

# Plance (sessioni_panel.py, plancia.py): chiave d'accesso LAN, stato di runtime.
# Analogo a .zp/ per zero-pending-loop, ma non e' roba sua.
.panel/

