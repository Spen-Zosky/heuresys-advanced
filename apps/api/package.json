{
  "name": "@heuresys/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — Fastify 5 API (58 modules, 272 endpoints, MVP-1 + ESS MVP-2b + MFA TOTP MVP-3 + brownfield-wave-executor state machine 8 stati)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "seed:reference-bank": "tsx ../../db/scripts/seed-reference-bank.ts",
    "embeddings:backfill": "tsx src/modules/semantic-matching/backfill.ts",
    "reference-sync:run": "tsx src/modules/reference-sync/sync-cli.ts",
    "insights:recompute": "tsx src/modules/insights/recompute-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@heuresys/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.1",
    "argon2": "0.44.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "6.1.0",
    "nodemailer": "^8.0.10",
    "otpauth": "^9.5.1",
    "pg": "8.21.0",
    "pg-format": "^1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@types/node": "22.19.20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "8.20.0",
    "@types/pg-format": "^1.0.5",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "0.31.10",
    "pino": "^10.3.1",
    "supertest": "7.2.2",
    "tsup": "^8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.7.2",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
