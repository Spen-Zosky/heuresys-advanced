{
  "name": "@heuresys/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — Fastify 4 API (23 modules, 148 endpoints, MVP-1 + ESS MVP-2b)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "seed:reference-bank": "tsx ../../db/scripts/seed-reference-bank.ts"
  },
  "dependencies": {
    "@heuresys/shared": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "argon2": "0.41.1",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.36.4",
    "fastify": "4.28.1",
    "fastify-plugin": "4.5.1",
    "fastify-type-provider-zod": "2.0.0",
    "pg": "8.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "9.3.0",
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.28.1",
    "pino": "9",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
