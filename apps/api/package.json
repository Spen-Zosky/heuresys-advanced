{
  "name": "@heuresys/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — Fastify 5 API (75 business modules + auth, ~407 /v1 endpoints; v1.0.0 GA + post-v1 ondata-1: reporting/export, notification center, agent-gateway)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --conditions heuresys-source src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run -c vitest.unit.config.ts && vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "seed:reference-bank": "tsx ../../db/scripts/seed-reference-bank.ts",
    "embeddings:backfill": "tsx src/modules/semantic-matching/backfill.ts",
    "reference-sync:run": "tsx src/modules/reference-sync/sync-cli.ts",
    "insights:recompute": "tsx src/modules/insights/recompute-cli.ts",
    "capability:recompute": "tsx src/modules/capability-composition/recompute-cli.ts",
    "capability-maturity:recompute": "tsx src/modules/capability-maturity/recompute-cli.ts",
    "notifications:digest": "tsx src/modules/notifications/digest-cli.ts",
    "approvals:sla": "tsx src/modules/approvals/sla-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@heuresys/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.11.2",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "6.1.0",
    "nodemailer": "^9.0.4",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.19.1",
    "pg": "8.22.0",
    "pg-format": "^1.0.4",
    "pino": "^10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@types/node": "22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.20.4",
    "@types/pg-format": "^1.0.5",
    "tsup": "^8.5.1",
    "tsx": "4.23.10",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
