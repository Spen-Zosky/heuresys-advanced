{
  "name": "@heuresys/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — Fastify 4 API (23 modules, 148 endpoints, MVP-1 + ESS MVP-2b)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "seed:reference-bank": "tsx ../../db/scripts/seed-reference-bank.ts"
  },
  "dependencies": {
    "pg": "8.13.1",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "@faker-js/faker": "9.3.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
