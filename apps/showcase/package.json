{
  "name": "@heuresys/showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Heuresys brand identity v1 — static showcase site (GitHub Pages deploy of apps/web /showcase routes)",
  "scripts": {
    "sync": "bash ../../scripts/sync-showcase.sh",
    "build": "bash ../../scripts/sync-showcase.sh && next build",
    "build:static": "bash ../../scripts/sync-showcase.sh && cross-env STATIC_EXPORT=1 next build",
    "start": "next start -p 3010",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heuresys/ui": "^0.1.6",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.19.20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
