{
  "name": "@heuresys/showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Heuresys brand identity v1 — static showcase site (GitHub Pages deploy of apps/web /showcase routes)",
  "scripts": {
    "sync": "bash ../../scripts/sync-showcase.sh",
    "build": "bash ../../scripts/sync-showcase.sh && next build",
    "build:static": "bash ../../scripts/sync-showcase.sh && cross-env STATIC_EXPORT=1 next build",
    "start": "next start -p 3010",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heuresys/ui": "^1.0.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cross-env": "10.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
