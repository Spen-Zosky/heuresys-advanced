    "react-dom": "19.2.5",
    "react-hook-form": "7.55.0",
    "react-i18next": "15.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.17.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "axe-playwright": "^2.2.2",
