    "test:e2e": "playwright test",
    "test:e2e:prod": "next build && playwright test --config=playwright.prod.config.ts",
    "i18n:check": "tsx scripts/check-i18n-parity.ts"
  },
  "dependencies": {
    "@heuresys/shared": "workspace:*",
