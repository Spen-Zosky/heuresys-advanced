{
  "name": "@heuresys/web",
  "version": "1.0.0",
  "private": true,
  "description": "Heuresys Advanced — Next.js 15 App Router admin console (MVP-2a) + Employee Self-Service Portal (MVP-2b), bilingual it/en",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:node22": "node scripts/e2e-node22.mjs test",
    "test:e2e:prod": "next build && node scripts/e2e-blocchi.mjs",
    "test:e2e:prod:node22": "next build && node scripts/e2e-blocchi.mjs",
    "i18n:check": "tsx scripts/check-i18n-parity.ts",
    "e2e:residue-check": "tsx scripts/check-e2e-residue.ts"
  },
  "dependencies": {
    "@heuresys/shared": "workspace:*",
    "@heuresys/ui": "^1.2.0",
    "@hookform/resolvers": "5.9.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "5.104.5",
    "i18next": "26.5.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.6.1",
    "axe-playwright": "^2.2.2",
    "otpauth": "^9.5.2",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
