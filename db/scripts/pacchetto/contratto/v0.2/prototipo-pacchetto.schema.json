  "$defs": {
    "codice": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{1,63}$"
    },
    "provaId": {
      "type": "string",
      "pattern": "^PR[0-9]{4,}$"
    },
    "testo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "it"
      ],
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "enOrigine": {
          "enum": [
            "ESCO",
            "ISTAT",
            "LLM",
            "MANUAL",
            "FONTE"
          ]
        }
      },
      "dependentRequired": {
        "en": [
          "enOrigine"
        ]
      }
    },
    "riscontro": {
      "type": "object",
      "required": [
        "fonti"
      ],
      "properties": {
        "fonti": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provaId"
          }
        },
        "senzaRiscontro": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "fonti": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "senzaRiscontro"
          ],
          "properties": {
            "senzaRiscontro": {
              "const": true
            }
          }
        }
      ]
    }
  }
