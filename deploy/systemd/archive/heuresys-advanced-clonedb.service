# Template — @@REPO_DIR@@ è reso dallo step "clone-db" di scripts/provision-linux-pc.sh.
#
# PERCHE' VIVE IN archive/ E NON IN deploy/systemd/. `scripts/vm-deploy.sh` installa e
# ABILITA ogni *.service/*.timer trovato in deploy/systemd/ su OGNI host che deploya, VM
# inclusa. Questo one-shot ha senso su un SOLO tipo di host: il gemello PROD off-prod
# (oggi linux-pc), che clona il DB DALLA VM. Sulla VM sarebbe un no-op distruttivo:
# proverebbe a clonare il database di produzione sopra sé stesso. La sottodirectory
# archive/ lo tiene fuori da quel glob — ci finisce solo per installazione esplicita.
# Stessa ragione di heuresys-backup-pull.service, che sta qui accanto.
#
# COSA FA. Riallinea il DB locale `heuresys_advanced` di linux-pc alla fotografia corrente
# della VM (scripts/clone-vm-db.sh: pg_dump -Fc via SSH -> pg_restore --clean --if-exists).
# Finora il refresh era solo on-demand: fra un lancio manuale e il successivo il gemello
# PROD serviva sulla LAN dati sempre piu' vecchi della produzione, e la divergenza non era
# visibile da nessuna parte (cluster Z-022).
#
# COSA **NON** FA (rettifica S1030). La prima stesura di questo commento diceva che il
# refresh serviva "ai 3 gate CI pesanti". Falso, verificato: `test-integration.yml:57` e
# `playwright-smoke.yml:39` impostano `POSTGRES_DB: heuresys_ci`, un database DISTINTO che
# questo unit non tocca. `heuresys_ci` viene creato da `db/scripts/setup-ci-database.sh`,
# invocato solo dal provisioning manuale — resta congelato al momento in cui e' stato
# creato. Non lo si e' accodato qui perche' quello script fa `dropdb --force` e il suo
# stesso header avverte di non eseguirlo durante un job CI: servirebbe prima una guardia di
# idle sul runner, altrimenti si crea una collisione che oggi non esiste. Lo staleness di
# `heuresys_ci` resta aperto come voce a se' nel piano zero-pendenze.
#
# PERCHE' FERMA api E web. pg_restore --clean droppa e ricrea gli oggetti: farlo sotto
# un'API che serve traffico significa errori transitori e una cache RBAC che resta
# appesa a righe non più esistenti. Si fermano prima e si riavviano dopo — con
# ExecStopPost, che systemd esegue SEMPRE, anche quando il clone fallisce: un refresh
# andato male non deve lasciare il gemello spento.
[Unit]
Description=Heuresys Advanced — refresh settimanale del DB clone dalla VM (Z-022)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
# Senza questo un fallimento notturno resterebbe invisibile fino al prossimo sguardo
# casuale a `systemctl --failed` (stessa lezione di S1029 sui 10 timer senza OnFailure).
OnFailure=heuresys-unit-failure@%n.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@
# pg_dump/pg_restore + ssh + rsync: nessun Node necessario per questo one-shot.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HEURESYS_REPO_ROOT=@@REPO_DIR@@
# SENZA il trattino, di proposito: se fermare i servizi non riesce, il restore NON deve
# partire. `pg_restore --clean` emette DROP che chiedono ACCESS EXCLUSIVE; con l'API
# connessa il DROP si mette in coda e trascina ogni lock successivo, e l'unico limite
# sarebbe TimeoutStartSec -> SIGTERM a meta' restore = database danneggiato. Meglio non
# cominciare. (La prima stesura aveva `-`, cioe' precondizione best-effort: rilievo della
# review adversarial S1030.)
ExecStartPre=/usr/bin/sudo -n /usr/bin/systemctl stop heuresys-advanced-web.service heuresys-advanced-api.service
# lock_timeout: se malgrado tutto un lock e' conteso, si fallisce in 30s invece di restare
# appesi fino al timeout dell'unit.
#
# LE VIRGOLETTE NON SONO ORNAMENTALI (D-78). In `Environment=` lo SPAZIO separa due
# assegnazioni: senza quotare, systemd non impostava `PGOPTIONS=-c lock_timeout=30s` ma
# `PGOPTIONS=-c` (monco) piu' una variabile `lock_timeout=30s` per conto suo. Ogni
# connessione locale del sanity check veniva allora RIFIUTATA dal server con
# «argomento della riga di comando non valido per il processo server: -c», lo script
# leggeva `?` su tutte e tre le tabelle e dichiarava FATAL — su un clone perfettamente
# allineato. Il restore non se ne accorgeva perche' gira come `postgres` via sudo e non
# eredita l'ambiente di enzo: falliva solo la MISURA, mai il dato.
Environment="PGOPTIONS=-c lock_timeout=30s"
ExecStart=/usr/bin/env bash @@REPO_DIR@@/scripts/clone-vm-db.sh
# QUI il trattino serve: ExecStopPost deve girare SEMPRE, anche quando il clone fallisce —
# un refresh andato male non deve lasciare spento il gemello.
ExecStopPost=-/usr/bin/sudo -n /usr/bin/systemctl start heuresys-advanced-api.service heuresys-advanced-web.service
# Il clone reale misurato: 62 s (16:31:31 -> 16:32:33, 6.4 s di CPU). 900 s lasciano un
# fattore 14 di margine; i 2700 s iniziali erano un'attesa in cui il gemello sarebbe
# rimasto spento 45 minuti prima che qualcuno se ne accorgesse.
TimeoutStartSec=900
