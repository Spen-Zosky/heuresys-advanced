# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh.
# Do NOT install this file directly; run the bootstrap script instead.
#
# ADR-0063 (piano AI-driven F4a, decisione E6): a ONE-SHOT round of the signalers. They read
# every tenant, write nothing but sys.sys_agent_signals, and put each new signal in the in-app
# inbox of the people who have it in their perimeter. No email (E6). CLI-bypass, no HTTP/auth.
# The numbers are computed by code: no model is called. Re-run: no duplicates.
# Activated by heuresys-advanced-agent-signals.timer. Exit 1 if the perimeter sentinel is not empty.
[Unit]
Description=Heuresys Advanced — segnalatori degli agenti (F4a, one-shot)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
OnFailure=heuresys-unit-failure@%n.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@/apps/api
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HEURESYS_REPO_ROOT=@@REPO_DIR@@
ExecStart=@@NODE_BIN@@/pnpm agents:signals
TimeoutStartSec=600
