# Static unit (no placeholders) — installed verbatim by scripts/vm-bootstrap.sh.
#
# ADR-0063 D3 (piano AI-driven F0c, decisione E5): every Monday the summary of the
# previous week (Monday to Sunday, Rome time) of the writes made with the assistant
# lands in the in-app inbox of every PLATFORM_ADMIN. After the daily digest (02:45)
# and the ESCO probe (Sun 03:30), before the working day.
[Unit]
Description=Heuresys Advanced — weekly assistant summary (F0c)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced

[Timer]
OnCalendar=Mon *-*-* 07:30:00 Europe/Rome
RandomizedDelaySec=300
# Run a missed occurrence after downtime; the CLI does not duplicate the notice.
Persistent=true
Unit=heuresys-advanced-agent-weekly-summary.service

[Install]
WantedBy=timers.target
