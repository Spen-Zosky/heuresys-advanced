# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh.
# Do NOT install this file directly; run the bootstrap script instead.
[Unit]
Description=Heuresys Advanced — API (Fastify + Zod, prod / node dist bundle)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@/apps/api
# PATH points at the nvm-managed Node (>=22, required by @heuresys/ui ->
# camera-controls). The exact bin dir is resolved at install time.
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
# PROD: run the pre-built bundle (dist/server.js, produced by `pnpm --filter @heuresys/api build`
# = tsup) with plain node — no tsx, no watcher. bootstrap / vm-deploy.sh build it before start.
Environment=NODE_ENV=production
# API port + DB connection come from the repo-root .env (PORT, POSTGRES_*).
# HEURESYS_REPO_ROOT lets the BUNDLED env.ts locate .env + .secrets/*.pem (the bundle sits at a
# different depth than src/config/env.ts, so its import.meta.url-relative calc can't be used).
Environment=HEURESYS_REPO_ROOT=@@REPO_DIR@@
ExecStart=@@NODE_BIN@@/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
