# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh.
# Do NOT install this file directly; run the bootstrap script instead.
#
# 3.3 BPM approval-flow slice-3b: a ONE-SHOT that scans overdue PENDING approval
# steps, reminds approvers (in-app), and escalates past the threshold to the request
# creator. In-app delivery is fully functional without SMTP. CLI-bypass, no HTTP/auth.
# Activated by heuresys-advanced-approvals-sla.timer.
[Unit]
Description=Heuresys Advanced — approval SLA/escalation scan (3.3 slice-3b, one-shot)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
# S1029: senza questo, un fallimento notturno resta invisibile finche' qualcuno
# non guarda `systemctl --failed` per caso. L'handler scrive journal + registro letto
# dal dashboard di sessione.
OnFailure=heuresys-unit-failure@%n.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@/apps/api
# nvm-managed Node (>=22) on PATH; pnpm lives alongside it.
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Lets env.ts locate the repo-root .env + .secrets when run from apps/api.
Environment=HEURESYS_REPO_ROOT=@@REPO_DIR@@
# CLI-bypass in-process run (tsx) — devDeps are present (frozen install, not --prod).
ExecStart=@@NODE_BIN@@/pnpm approvals:sla
TimeoutStartSec=600
