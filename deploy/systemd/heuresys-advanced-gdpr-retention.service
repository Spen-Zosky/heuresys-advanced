# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh / vm-deploy.sh;
# User= is rewritten per-host by the deploy (ubuntu on the VM, enzo on the twin — D-39).
#
# D-63: ONE-SHOT che esegue scripts/gdpr-retention-sweep.sh — sweep
# registry-driven delle finestre di retention dichiarate in
# sys.sys_gdpr_data_map (es. auth_login_events 400gg). Gemello batch di
# POST /v1/gdpr/retention/run (che resta per l'invocazione manuale PLATFORM).
[Unit]
Description=Heuresys Advanced — daily GDPR retention sweep (D-63)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
# S1029: senza questo, un fallimento notturno resta invisibile finche' qualcuno
# non guarda `systemctl --failed` per caso. L'handler scrive journal + registro letto
# dal dashboard di sessione.
OnFailure=heuresys-unit-failure@%n.service
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=@@REPO_DIR@@
ExecStart=/usr/bin/env bash @@REPO_DIR@@/scripts/gdpr-retention-sweep.sh
