# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh.
# Do NOT install this file directly; run the bootstrap script instead.
#
# cap⑤ scraping P2 (D-2): a ONE-SHOT that refreshes official reference taxonomies
# (ESCO + ISTAT ATECO 2025, S983) in-process against the DB — CLI-bypass, no HTTP/auth
# (the per-source watermark makes an unchanged upstream a cheap no-op). Activated by
# heuresys-advanced-scraping.timer; the CLI iterates every registered source.
[Unit]
Description=Heuresys Advanced — reference-sync (cap⑤ official-source refresh ESCO+ATECO, one-shot)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
# S1029: senza questo, un fallimento notturno resta invisibile finche' qualcuno
# non guarda `systemctl --failed` per caso. L'handler scrive journal + registro letto
# dal dashboard di sessione.
OnFailure=heuresys-unit-failure@%n.service
After=network-online.target postgresql.service
Wants=network-online.target
# 2026-10-25: ESCO was behind the EC maintenance page for hours and the run failed until
# the next weekly tick. An upstream outage now gets retried every 2 h (Restart= below),
# at most 6 starts per day. RestartMode=direct (systemd >= 254) keeps the unit out of the
# failed state between attempts, so OnFailure= fires once, when the retries are exhausted
# (measured on the VM, systemd 255: without it OnFailure= fired at every attempt).
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@/apps/api
# nvm-managed Node (>=22) on PATH; pnpm lives alongside it.
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Lets env.ts locate the repo-root .env + .secrets when run from apps/api.
Environment=HEURESYS_REPO_ROOT=@@REPO_DIR@@
# CLI-bypass in-process run (tsx) — devDeps are present (frozen install, not --prod).
ExecStart=@@NODE_BIN@@/pnpm reference-sync:run
TimeoutStartSec=900
Restart=on-failure
RestartMode=direct
RestartSec=2h
