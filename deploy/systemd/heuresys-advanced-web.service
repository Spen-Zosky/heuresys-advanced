# Template — placeholders (@@...@@) are rendered by scripts/vm-bootstrap.sh.
# Do NOT install this file directly; run the bootstrap script instead.
[Unit]
Description=Heuresys Advanced — Web (Next.js prod / next start)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced
After=network-online.target heuresys-advanced-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@@REPO_DIR@@/apps/web
Environment=PATH=@@NODE_BIN@@:/usr/local/bin:/usr/bin:/bin
# PROD: the VM is the production environment (not dev) — see SOT. Served from a
# pre-built .next (next build), so pages are instant (no on-demand compile).
# bootstrap (and scripts/vm-deploy.sh) run `next build` BEFORE (re)starting this.
Environment=NODE_ENV=production
# Same-origin proxy: browser hits /api/* on the web origin, Next proxies it
# server-side to the API so HttpOnly/SameSite cookies + CSRF keep working.
# NOTE: NEXT_PUBLIC_* are inlined at BUILD time — the build step must export the
# same values (it does, derived from PUBLIC_HOST/API_PORT). Kept here for parity.
Environment=NEXT_PUBLIC_API_PROXY_BASE_URL=http://localhost:@@API_PORT@@
Environment=NEXT_PUBLIC_API_BASE_URL=http://@@PUBLIC_HOST@@:@@API_PORT@@/v1
# next start serves the pre-built output; package.json start hardcodes -p 3000,
# so override port + bind-all here. pnpm is the corepack shim in the nvm Node bin.
ExecStart=@@NODE_BIN@@/pnpm exec next start -p @@WEB_PORT@@ -H 0.0.0.0
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
