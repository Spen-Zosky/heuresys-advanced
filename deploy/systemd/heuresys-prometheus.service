# deploy/systemd/heuresys-prometheus.service — D-09 F5: local metrics collector
# (rendered by vm-deploy.sh: @@placeholders@@ + User=). Loopback-only
# (127.0.0.1:9090), scrapes the API /metrics gated endpoint; retention 15d/2GB
# (OCI free-tier disk budget). Installed by every deploy (unit render loop) but
# ENABLED only where provisioned (scripts/provision-prometheus-vm.sh) — on the
# linux-pc twin the binary is absent and the unit stays disabled, by design.
[Unit]
Description=Heuresys local Prometheus collector (D-09)
After=network.target heuresys-advanced-api.service

[Service]
User=ubuntu
Group=ubuntu
ExecStart=/opt/prometheus/prometheus \
  --config.file=@@REPO_DIR@@/deploy/prometheus/prometheus.yml \
  --storage.tsdb.path=/var/lib/heuresys-prometheus \
  --storage.tsdb.retention.time=15d \
  --storage.tsdb.retention.size=2GB \
  --web.listen-address=127.0.0.1:9090
Restart=on-failure
RestartSec=10
# resource slice: the collector must never compete with PROD services
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
