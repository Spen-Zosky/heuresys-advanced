# Static unit (nessun segnaposto). Si installa a mano, vedi README.md qui accanto.
#
# Ogni 20 minuti (2026-11-19): l'atlante diventa vecchio a ogni unione e, finche' resta vecchio,
# Atlas freshness su main e' rosso e deploy-watch ferma il rilascio. Il giro costa un `git fetch`
# quando main non e' cambiato (lo script esce subito), e la PR che apre si unisce da sola a CI verde.
[Unit]
Description=Heuresys Advanced — tick dell'atlante automatico ogni 20 minuti (A2)
Documentation=https://github.com/Spen-Zosky/heuresys-advanced

[Timer]
OnCalendar=*:0/20
RandomizedDelaySec=60
# Recupera il giro perso se la VM era spenta.
Persistent=true
Unit=heuresys-advanced-atlante.service

[Install]
WantedBy=timers.target
