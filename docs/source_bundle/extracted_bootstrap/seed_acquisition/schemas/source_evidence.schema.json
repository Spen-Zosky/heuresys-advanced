{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Evidence",
  "type": "object",
  "required": [
    "source_code",
    "source_url",
    "retrieved_at"
  ],
  "properties": {
    "source_code": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "evidence_excerpt": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string"
    }
  }
}