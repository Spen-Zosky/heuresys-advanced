{
  "name": "heuresys-advanced",
  "version": "0.1.0",
  "private": true,
  "description": "Heuresys Advanced HRMS/BPM Platform v5 — monorepo (Fastify API + Next.js 15 admin/ESS + shared schemas + DB migrations)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=\"@heuresys/*\" run dev",
    "build": "pnpm -r --filter=\"@heuresys/*\" run build",
    "test": "pnpm -r --filter=\"@heuresys/*\" run test",
    "lint": "pnpm -r --filter=\"@heuresys/*\" run lint",
    "typecheck": "pnpm -r --filter=\"@heuresys/*\" run typecheck",
    "db:create": "pwsh -File db/scripts/create_local_database.ps1",
    "db:create:sh": "bash db/scripts/create_local_database.sh",
    "db:migrate": "pwsh -File db/scripts/migrate.ps1",
    "db:migrate:sh": "bash db/scripts/migrate.sh",
    "db:reset": "pwsh -File db/scripts/reset_local_database.ps1",
    "db:validate": "pwsh -File db/scripts/validate_database.ps1",
    "db:seed": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-reference-bank.ts",
    "db:seed-test-admin": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-test-admin.ts",
    "db:seed-r2": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-r2-personas.ts",
    "db:seed-r1b": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-r1b-personas.ts",
    "i18n:check": "pnpm --filter @heuresys/web run i18n:check",
    "cowork:status": "node scripts/cowork-exchange/status.mjs",
    "cowork:validate": "node scripts/cowork-exchange/validate-naming.mjs",
    "cowork:validate:strict": "node scripts/cowork-exchange/validate-naming.mjs --strict",
    "cowork:new-goal": "node scripts/cowork-exchange/new-goal.mjs",
    "cowork:install-hooks": "node scripts/cowork-exchange/install-hooks.mjs",
    "cowork:session-start": "node scripts/cowork-exchange/session-start.mjs",
    "cowork:session-end": "node scripts/cowork-exchange/session-end.mjs",
    "cowork:inbox": "node scripts/cowork-exchange/inbox.mjs",
    "cowork:inbox:rebuild": "node scripts/cowork-exchange/inbox.mjs --rebuild-index",
    "cowork:notify": "node scripts/cowork-exchange/notify.mjs",
    "cowork:acquire-lock": "node scripts/cowork-exchange/locks.mjs acquire",
    "cowork:release-lock": "node scripts/cowork-exchange/locks.mjs release",
    "cowork:check-locks": "node scripts/cowork-exchange/locks.mjs check",
    "cowork:apply-pending": "node scripts/cowork-exchange/apply-pending.mjs"
  },
  "dependencies": {
    "@heuresys/ui": "^0.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "globals": "17.6.0",
    "typescript-eslint": "8.60.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2",
      "postcss": "^8.5.10",
      "esbuild": "^0.25.0",
      "qs": ">=6.15.2",
      "exceljs>uuid": ">=11.1.1",
      "exceljs>tmp": ">=0.2.6",
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
