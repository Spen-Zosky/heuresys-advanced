{
  "name": "heuresys-advanced",
  "version": "1.0.0",
  "private": true,
  "description": "Heuresys Advanced HRMS/BPM Platform v5 — monorepo (Fastify API + Next.js 16 admin/ESS + agent-gateway + shared schemas + DB migrations)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=\"@heuresys/*\" run dev",
    "build": "pnpm -r --filter=\"@heuresys/*\" run build",
    "test": "pnpm -r --filter=\"@heuresys/*\" run test",
    "lint": "pnpm -r --filter=\"@heuresys/*\" run lint",
    "typecheck": "pnpm -r --filter=\"@heuresys/*\" run typecheck",
    "clean": "bash scripts/clean.sh",
    "clean:dumps": "bash scripts/clean.sh --dumps-dry-run",
    "clean:deep": "bash scripts/clean.sh --deep",
    "db:create": "pwsh -File db/scripts/create_local_database.ps1",
    "db:create:sh": "bash db/scripts/create_local_database.sh",
    "db:migrate": "pwsh -File db/scripts/migrate.ps1",
    "db:migrate:sh": "bash db/scripts/migrate.sh",
    "db:migrate:if-pending": "bash db/scripts/migrate-if-pending.sh",
    "db:reset": "pwsh -File db/scripts/reset_local_database.ps1",
    "db:validate": "pwsh -File db/scripts/validate_database.ps1",
    "db:seed": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-reference-bank.ts",
    "db:seed-test-admin": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-test-admin.ts",
    "db:seed-r2": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-r2-personas.ts",
    "db:seed-r1b": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-r1b-personas.ts",
    "db:seed-service-user": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/seed-service-user.ts",
    "db:encrypt-totp": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/encrypt-totp-secrets.ts",
    "dev:whoami": "pnpm --filter @heuresys/api exec node scripts/dev-whoami.mjs",
    "db:provision-access": "pnpm --filter @heuresys/api exec tsx ../../db/scripts/provision-derived-access.ts",
    "embeddings:backfill": "pnpm --filter @heuresys/api exec tsx src/modules/semantic-matching/backfill.ts",
    "i18n:check": "pnpm --filter @heuresys/web run i18n:check",
    "status": "python docs/kb/tools/status_dashboard.py",
    "plancia": "python scripts/plancia.py",
    "plancia:sessioni": "python scripts/sessioni_panel.py",
    "plancia:zp": "python scripts/zp_panel.py"
  },
  "dependencies": {
    "@heuresys/ui": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "17.9.0",
    "playwright": "1.62.1",
    "typescript-eslint": "8.66.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "vite": "^8.1.5",
      "postcss": "^8.5.18",
      "esbuild": ">=0.28.1",
      "qs": ">=6.15.2",
      "form-data": ">=4.0.6",
      "js-yaml": "^4.3.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.8",
      "dompurify": ">=3.4.13",
      "nanoid": "^3.3.18",
      "mermaid": ">=11.16.1",
      "exceljs>uuid": ">=11.1.1",
      "exceljs>tmp": ">=0.2.6",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@fastify/static": ">=10.1.2",
      "find-my-way": ">=9.7.0",
      "fast-uri": ">=4.1.2",
      "ip-address": ">=10.3.1",
      "hono": ">=4.12.34",
      "sharp": ">=0.35.0",
      "@hono/node-server": ">=2.0.5"
    }
  }
}
