{
  "name": "@heuresys/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — shared Zod schemas + TypeScript types consumed by @heuresys/api and @heuresys/web",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {}
}
