{
  "name": "@heuresys/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heuresys Advanced — shared Zod schemas + TypeScript types consumed by @heuresys/api and @heuresys/web",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schemas/auth": {
      "types": "./dist/schemas/auth.d.ts",
      "default": "./src/schemas/auth.ts"
    },
    "./schemas/role-codes": {
      "types": "./dist/schemas/role-codes.d.ts",
      "default": "./src/schemas/role-codes.ts"
    },
    "./schemas/tenants": {
      "types": "./dist/schemas/tenants.d.ts",
      "default": "./src/schemas/tenants.ts"
    },
    "./schemas/users": {
      "types": "./dist/schemas/users.d.ts",
      "default": "./src/schemas/users.ts"
    },
    "./schemas/positions": {
      "types": "./dist/schemas/positions.d.ts",
      "default": "./src/schemas/positions.ts"
    },
    "./schemas/organization-units": {
      "types": "./dist/schemas/organization-units.d.ts",
      "default": "./src/schemas/organization-units.ts"
    },
    "./schemas/skills": {
      "types": "./dist/schemas/skills.d.ts",
      "default": "./src/schemas/skills.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  }
}
